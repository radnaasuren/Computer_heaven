# Public URL of pc_parts_api (Express). Default in code is http://localhost:4000.
# Run the API with PORT=4000 (see pc_parts_api/.env.example) so Next.js can use 3000.
# Auth + orders: POST /api/auth/login, GET/POST /api/orders (Bearer token).
NEXT_PUBLIC_PC_PARTS_API_URL=http://localhost:4000

# Optional legacy GraphQL (products admin) — separate from pc_parts_api.
# NEXT_PUBLIC_API_URL=http://localhost:3000
